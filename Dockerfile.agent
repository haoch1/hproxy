# Containerized agents use host networking and a persistent volume. Their
# lifecycle belongs to Docker/Podman; controller-triggered removal is disabled.
FROM alpine:3.22 AS release
ARG TARGETARCH
ARG TARGETVARIANT
COPY release-bundle/ /bundle/
RUN set -eu; \
    case "${TARGETARCH}/${TARGETVARIANT}" in \
      amd64/*) platform=linux-amd64 ;; \
      arm64/*) platform=linux-arm64 ;; \
      arm/v7) platform=linux-armv7 ;; \
      *) echo "Unsupported image platform: ${TARGETARCH}/${TARGETVARIANT}" >&2; exit 1 ;; \
    esac; \
    cp "/bundle/hproxy-agent-${platform}" /hproxy-agent; \
    chmod 0555 /hproxy-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 10001 hproxy && \
    adduser -S -D -H -u 10001 -G hproxy hproxy && \
    mkdir -p /var/lib/hproxy/agent/cores && \
    chown -R hproxy:hproxy /var/lib/hproxy/agent
COPY --from=release /hproxy-agent /usr/local/bin/hproxy-agent
COPY scripts/oci-agent-enroll.sh /usr/local/bin/hproxy-agent-enroll
RUN chmod 0555 /usr/local/bin/hproxy-agent-enroll
USER 10001:10001
WORKDIR /var/lib/hproxy/agent
ENTRYPOINT ["/usr/local/bin/hproxy-agent"]
CMD ["run", "--data", "/var/lib/hproxy/agent", "--core-dir", "/var/lib/hproxy/agent/cores"]
